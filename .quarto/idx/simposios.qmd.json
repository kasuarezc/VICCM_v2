{"title":"Simposios","markdown":{"yaml":{"title":"Simposios","format":{"html":{"css":["css/main.css","css/simposios.css","css/responsive.css"]}}},"containsRefs":false,"markdown":"\n\n<section class=\"simposios-hero\">\n<div class=\"container\">\n<h1>Simposios del Congreso</h1>\n<p>Conoce los simposios temáticos, organizadores y detalles de cada actividad académica del VICCM 2026</p>\n</div>\n</section>\n\n<section class=\"simposios-page\">\n<div class=\"filtros-container\">\n<div class=\"filtros-categorias\">\n<button class=\"filtro-btn active\" data-categoria=\"todos\" type=\"button\">Todos</button>\n<button class=\"filtro-btn\" data-categoria=\"conservacion\" type=\"button\">Conservación</button>\n<button class=\"filtro-btn\" data-categoria=\"ecologia\" type=\"button\">Ecología</button>\n<button class=\"filtro-btn\" data-categoria=\"primates\" type=\"button\">Primates</button>\n<button class=\"filtro-btn\" data-categoria=\"quiropteros\" type=\"button\">Quirópteros</button>\n<button class=\"filtro-btn\" data-categoria=\"estrategias\" type=\"button\">Estrategias</button>\n<button class=\"filtro-btn\" data-categoria=\"xenartros\" type=\"button\">Xenartros</button>\n<button class=\"filtro-btn\" data-categoria=\"gestion\" type=\"button\">Gestión Adaptativa</button>\n<button class=\"filtro-btn\" data-categoria=\"salud\" type=\"button\">Salud</button>\n</div>\n\n<div class=\"busqueda-wrapper\">\n<span class=\"busqueda-icon\">🔎</span>\n<input type=\"text\" class=\"busqueda-input\" placeholder=\"Buscar simposios...\" id=\"busquedaInput\">\n</div>\n</div>\n\n<div class=\"simposios-grid\" id=\"simposiosGrid\">\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"ecologia\"\ndata-titulo=\"Interacciones troficas en mamiferos: de flores a depredadores\"\ndata-organizadores=\"Kevin González Gutiérrez, John Harold Castaño Salazar\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/interacciones/images/interacciones.jpeg\" alt=\"Interacciones\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Kevin González Gutiérrez</span>\n<span class=\"simposio-organizador\">John Harold Castaño Salazar</span>\n</div>\n<h3 class=\"simposio-titulo\">Interacciones troficas en mamiferos: de flores a depredadores</h3>\n<p class=\"simposio-descripcion\">\nLas interacciones tróficas son fundamentales para comprender procesos ecológicos a nivel de individuo, especie, población y comunidad, ya que permiten analizar aspectos comportamentales, metabólicos, fenológicos, geográficos y dependientes de la escala en la transformación del paisaje.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Método</span>\n</div>\n<a href=\"simposios/interacciones/interacciones.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"estrategias, conservacion\"\ndata-titulo=\"Estrategias comunitarias en gestión del conocimiento y conservación de mamíferos\"\ndata-organizadores=\"Miguel E. Rodríguez-Posada, Dora Catalina Concha Osbahr, Bibiana Gómez-Valencia, Andrea Natalia Martínez Bulla\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/estrategias/images/estrategias.jpeg\" alt=\"Interacciones\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Miguel E. Rodríguez-Posada</span>\n<span class=\"simposio-organizador\">Dora Catalina Concha Osbahr</span>\n<span class=\"simposio-organizador\">Bibiana Gómez-Valencia</span>\n<span class=\"simposio-organizador\">Andrea Natalia Martínez Bulla</span>\n</div>\n<h3 class=\"simposio-titulo\">Estrategias comunitarias en gestión del conocimiento y conservación de mamíferos</h3>\n<p class=\"simposio-descripcion\">\nRecientemente se ha incrementado la participación de actores sociales, especialmente las comunidades locales, en las estrategias de gestión y conservación de la biodiversidad en sus territorios para garantizar su efectividad bajo su propia gobernanza.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Monitoreo Comunitario</span>\n<span class=\"tema-tag\">Gobernanza</span>\n</div>\n<a href=\"simposios/estrategias/estrategias.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"quiropteros\"\ndata-titulo=\"I Simposio de Refugios de Murciélagos en Colombia\"\ndata-organizadores=\"Liceth Margarita Suárez Payares, Tomás Villada-Cadavid, Melquisedec Gamba-Ríos, Sandra Bernal, Yesyca Andrea López Bolaños, Ana María Ávila García, Diana Carina Vallejo Cardozo\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/refugios/images/refugios.jpeg\" alt=\"Refugios\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Liceth Margarita Suárez Payares</span>\n<span class=\"simposio-organizador\">Tomás Villada-Cadavid</span>\n<span class=\"simposio-organizador\">Melquisedec Gamba-Ríos</span>\n<span class=\"simposio-organizador\">Sandra Bernal</span>\n<span class=\"simposio-organizador\">Yesyca Andrea López Bolaños</span>\n<span class=\"simposio-organizador\">Ana María Ávila García</span>\n<span class=\"simposio-organizador\">Diana Carina Vallejo Cardozo</span>\n</div>\n<h3 class=\"simposio-titulo\">I Simposio de Refugios de Murciélagos en Colombia</h3>\n<p class=\"simposio-descripcion\"> Bastaron dos décadas para percatarnos acerca de lo imperativo de proponer nuevas estrategias para el estudio de los refugios de murciélagos en Colombia.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Quirópteros</span>\n<span class=\"tema-tag\">Murciélagos</span>\n</div>\n<a href=\"simposios/refugios/refugios.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"xenartros\"\ndata-titulo=\"VI Simposio Colombiano de Perezosos, Armadillos y Hormigueros\"\ndata-organizadores=\"Carlos Aya Cuero, Maria Jose Andrade, Julio Chacón Pacheco, Catalina Perez, Nathalia Niño, Cesar Rojano\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/perezosos/images/perezosos.jpeg\" alt=\"Perezosos\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Carlos Aya Cuero</span>\n<span class=\"simposio-organizador\">Maria Jose Andrade</span>\n<span class=\"simposio-organizador\">Julio Chacón Pacheco</span>\n<span class=\"simposio-organizador\">Catalina Perez</span>\n<span class=\"simposio-organizador\">Nathalia Niño</span>\n<span class=\"simposio-organizador\">Cesar Rojano</span>\n</div>\n<h3 class=\"simposio-titulo\">VI Simposio Colombiano de Perezosos, Armadillos y Hormigueros</h3>\n<p class=\"simposio-descripcion\"> El VI Simposio Colombiano de Perezosos, Armadillos y Hormigueros da continuidad a los cinco encuentros previos que han consolidado un espacio técnico y científico dedicado al estudio y conservación de los xenartros en el país.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Xenartros</span>\n<span class=\"tema-tag\">Perezosos</span>\n</div>\n<a href=\"simposios/perezosos/perezosos.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"primates\"\ndata-titulo=\"VII Simposio Colombiano de Primatología\"\ndata-organizadores=\"Carlos Aya Cuero, Maria Jose Andrade, Julio Chacón Pacheco, Catalina Perez, Nathalia Niño, Cesar Rojano\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/primatologia/images/primatologia.jpeg\" alt=\"Primatologia\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Sebastián García Restrepo</span>\n<span class=\"simposio-organizador\">Sebastián O. Montilla</span>\n<span class=\"simposio-organizador\">María Gabriela Luna Conde</span>\n<span class=\"simposio-organizador\">Rafael Santiago Escucha Ramírez</span>\n<span class=\"simposio-organizador\">Efraín Camilo Mora Cruz</span>\n<span class=\"simposio-organizador\">Sergio González Linares</span>\n</div>\n<h3 class=\"simposio-titulo\">VII Simposio Colombiano de Primatología</h3>\n<p class=\"simposio-descripcion\"> Colombia alberga una alta riqueza de especies de primates (alrededor de 38 a 40 especies) y a lo largo de los años se ha posicionado como un referente latinoamericano en cuanto al potencial de investigación y a las capacidades de sus profesionales y grupos de investigación en Primatología.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Primates</span>\n</div>\n<a href=\"simposios/primatologia/primatologia.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"gestion, estrategias\"\ndata-titulo=\"Gestión Adaptativa y Alianzas Estratégicas: El Rol de los Zoológicos en la Mastozoología Moderna\"\ndata-organizadores=\"Dave Wehdeking, Catalina Rodríguez Álvarez, Sandra Marcela Gómez, Carlos Andrés Galvis, Leonardo Arias Bernal\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/gestion_adaptativa/images/gestion_adaptativa.jpg\" alt=\"Gestion Adaptativa\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Dave Wehdeking</span>\n<span class=\"simposio-organizador\">Catalina Rodríguez Álvarez</span>\n<span class=\"simposio-organizador\">Sandra Marcela Gómez</span>\n<span class=\"simposio-organizador\">Carlos Andrés Galvis</span>\n<span class=\"simposio-organizador\">Leonardo Arias Bernal</span>\n</div>\n<h3 class=\"simposio-titulo\">Gestión Adaptativa y Alianzas Estratégicas: El Rol de los Zoológicos en la Mastozoología Moderna</h3>\n<p class=\"simposio-descripcion\"> La conservación de los mamíferos enfrenta desafíos cada vez más complejos que requieren enfoques integrados y una colaboración efectiva entre múltiples actores.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Gestión Adaptativa</span>\n<span class=\"tema-tag\">Zoológicos</span>\n</div>\n<a href=\"simposios/gestion_adaptativa/gestion_adaptativa.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"conservacion\"\ndata-titulo=\"Comunicación, Sensibilización y Enseñanza para la Conservación de Mamíferos: Experiencias, Estrategias y Retos\"\ndata-organizadores=\"Catalina Rodriguez, César Rojano, Mónica Peñuela Salgado, Juan Camilo Rubiano Pérez, Mariana Zanotti Tavares de Oliveira, Ginna Gómez Junco, Diana Alejandra Moncada Garzón, Katherine Pérez Gómez, Angie Tinoco Sotomayor, Luisa Fernanda Blanco Uribe, Carlos Ágamez López, Oscar Ducuara, Mariana Vélez Orozco, María Camila Machado Aguilar\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/comunicacion_sensibilizacion/images/comunicacion_sensibilizacion.jpeg\" alt=\"Comunicacion, Sensibilizacion y enseñanza\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Catalina Rodriguez</span>\n<span class=\"simposio-organizador\">César Rojano</span>\n<span class=\"simposio-organizador\">Mónica Peñuela Salgado</span>\n<span class=\"simposio-organizador\">Juan Camilo Rubiano Pérez</span>\n<span class=\"simposio-organizador\">Mariana Zanotti Tavares de Oliveira</span>\n<span class=\"simposio-organizador\">Ginna Gómez Junco</span>\n<span class=\"simposio-organizador\">Diana Alejandra Moncada Garzón</span>\n<span class=\"simposio-organizador\">Katherine Pérez Gómez</span>\n<span class=\"simposio-organizador\">Angie Tinoco Sotomayor</span>\n<span class=\"simposio-organizador\">Luisa Fernanda Blanco Uribe</span>\n<span class=\"simposio-organizador\">Carlos Ágamez López</span>\n<span class=\"simposio-organizador\">Oscar Ducuara</span>\n<span class=\"simposio-organizador\">Mariana Vélez Orozco</span>\n<span class=\"simposio-organizador\">María Camila Machado Aguilar</span>\n</div>\n<h3 class=\"simposio-titulo\">Comunicación, Sensibilización y Enseñanza para la Conservación de Mamíferos: Experiencias, Estrategias y Retos</h3>\n<p class=\"simposio-descripcion\">Este simposio busca generar un espacio de encuentro e intercambio entre investigadores, docentes, estudiantes, organizaciones e iniciativas que desarrollan procesos de comunicación, sensibilización y enseñanza relacionados con la conservación de mamíferos.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Comunicación</span>\n<span class=\"tema-tag\">Enseñanza</span>\n</div>\n<a href=\"simposios/comunicacion_sensibilizacion/comunicacion_sensibilizacion.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"conservacion\"\ndata-titulo=\"Evaluaciones de amenazas: de lo global a lo local\"\ndata-organizadores=\"Maria Alejandra Hurtado Materon, Baltazar Gonzalez, José F. González-Maya\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/evaluaciones_amenazas/images/evaluaciones_amenazas.jpg\" alt=\"Evaluaciones de Amenazas\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Maria Alejandra Hurtado Materon</span>\n<span class=\"simposio-organizador\">Baltazar Gonzalez</span>\n<span class=\"simposio-organizador\">José F. González-Maya</span>\n</div>\n<h3 class=\"simposio-titulo\">Evaluaciones de amenazas: de lo global a lo local</h3>\n<p class=\"simposio-descripcion\">\nEl simposio propuesto se establece como un espacio de vanguardia para el intercambio académico y práctico sobre la evaluación de mamíferos, trascendiendo la escala nacional para entender cómo los contextos locales informan las metas globales de biodiversidad.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Método</span>\n</div>\n<a href=\"simposios/evaluaciones_amenazas/evaluaciones_amenazas.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n<div class=\"simposio-card\"\ndata-categoria=\"quiropteros\"\ndata-titulo=\"VI Simposio Colombiano de Quiropterología\"\ndata-organizadores=\"Sebastián Montoya-Bustamante, Natalya Zapata-Mesa, María A. Hurtado-Materón\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/quiropterologia/images/quiropterologia.jpg\" alt=\"quiropterologia\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Sebastián Montoya-Bustamante</span>\n<span class=\"simposio-organizador\">Natalya Zapata-Mesa</span>\n<span class=\"simposio-organizador\">María A. Hurtado-Materón</span>\n</div>\n<h3 class=\"simposio-titulo\">VI Simposio Colombiano de Quiropterología</h3>\n<p class=\"simposio-descripcion\">\nLos murciélagos constituyen uno de los grupos de mamíferos más diversos y ecológicamente relevantes del planeta, y Colombia, con su excepcional biodiversidad, alberga una de las quiropterofaunas más ricas del mundo.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">quiropteros</span>\n<span class=\"tema-tag\">Murciélagos</span>\n</div>\n<a href=\"simposios/quiropterologia/quiropterologia.html\" class=\"simposio-btn\">\nVer Simposio Completo →</a>\n</div>\n</div>\n\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"estrategias\"\ndata-titulo=\"Mamíferos en paisajes productivos de Colombia: enfoques, experiencias y retos\"\ndata-organizadores=\"Freddy Gamboa Avellaneda, Natalia Rodríguez Santa\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/mamiferos_paisajes/images/mamiferos_paisajes.png\" alt=\"Mamiferos en paisajes\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Freddy Gamboa Avellaneda</span>\n<span class=\"simposio-organizador\">Natalia Rodríguez Santa</span>\n</div>\n<h3 class=\"simposio-titulo\">Mamíferos en paisajes productivos de Colombia: enfoques, experiencias y retos</h3>\n<p class=\"simposio-descripcion\">\nEste simposio reúne experiencias, investigaciones y enfoques interdisciplinarios sobre mamíferos en paisajes productivos de Colombia, así como el potencial de territorios emergentes para la investigación.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Estrategias</span>\n</div>\n<a href=\"simposios/mamiferos_paisajes/mamiferos_paisajes.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"salud\"\ndata-titulo=\"La mastozoología en la era One health\"\ndata-organizadores=\"Hugo Mantilla-Meluk, Nicolás Rafael Reyes-Amaya\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/mastozoologia_onehealth/images/mastozoologia_onehealth.jpg\" alt=\"La mastozoología en la era One health\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Hugo Mantilla-Meluk</span>\n<span class=\"simposio-organizador\">Nicolás Rafael Reyes-Amaya</span>\n</div>\n<h3 class=\"simposio-titulo\">La mastozoología en la era One health</h3>\n<p class=\"simposio-descripcion\">\nEn consonancia con el Marco Global de Biodiversidad de Kunming-Montreal, que promueve la implementación del esquema de Una Salud.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Salud</span>\n</div>\n<a href=\"simposios/mastozoologia_onehealth/mastozoologia_onehealth.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"ecologia\"\ndata-titulo=\"V Simposio de conectividad ecológica y V Simposio de distribución de especies\"\ndata-organizadores=\"Ángela P. Hurtado-Moreno, Diego A. Zárrate Charry, José F. González-Maya, Leonardo Lemus-Mejia, Carlos Eduardo Ortiz Yusty, María Gabriela Aduén Espinosa, Camilo Andrés Correa Ayram, Elkin Noguera, Maria Camila Machado-Aguilera\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/conectividad_ecologica/images/conectividad_ecologica.jpg\" alt=\"Modelos y territorios: conectando ciencia para la planificación responsable\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Ángela P. Hurtado-Moreno</span>\n<span class=\"simposio-organizador\">Diego A. Zárrate Charry</span>\n<span class=\"simposio-organizador\">José F. González-Maya</span>\n<span class=\"simposio-organizador\">Leonardo Lemus-Mejia</span>\n<span class=\"simposio-organizador\">Carlos Eduardo Ortiz Yusty</span>\n<span class=\"simposio-organizador\">María Gabriela Aduén Espinosa</span>\n<span class=\"simposio-organizador\">Camilo Andrés Correa Ayram</span>\n<span class=\"simposio-organizador\">Elkin Noguera</span>\n<span class=\"simposio-organizador\">Maria Camila Machado-Aguilera</span>\n</div>\n<h3 class=\"simposio-titulo\">V Simposio de conectividad ecológica y V Simposio de distribución de especies</h3>\n<p class=\"simposio-descripcion\"> Las aproximaciones de investigación direccionadas a entender cómo se distribuye una especie en el espacio y cómo se mueve a través de un paisaje permiten tener un marco conceptual y metodológico robusto para orientar la toma de decisiones en el ordenamiento territorial.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n</div>\n<a href=\"simposios/conectividad_ecologica/conectividad_ecologica.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n\n\n</div>\n\n<div class=\"paginacion\">\n  <ul>\n    <li><a href=\"simposios.html\" class=\"page-item active\">1</a></li>\n    <li><a href=\"simposios_2.html\" class=\"page-item2\">2</a></li>\n    <li><a href=\"simposios_3.html\" class=\"page-item3\">3</a></li>\n    <li><a href=\"simposios_2.html\" class=\"page-item4\">→</a></li>\n  </ul>\n</div>\n</section>\n\n\n\n<section class=\"newsletter-section\">\n<div class=\"newsletter-container\">\n<h2>📬 Recibe nuestras noticias</h2>\n<p>Suscríbete para recibir las últimas actualizaciones del congreso directamente en tu correo</p>\n<div class=\"newsletter-form\">\n<input type=\"email\" class=\"newsletter-input\" placeholder=\"Tu correo electrónico\">\n<button class=\"newsletter-btn\" type=\"button\">Suscribirme</button>\n</div>\n</div>\n</section>\n","srcMarkdownNoYaml":"\n\n<section class=\"simposios-hero\">\n<div class=\"container\">\n<h1>Simposios del Congreso</h1>\n<p>Conoce los simposios temáticos, organizadores y detalles de cada actividad académica del VICCM 2026</p>\n</div>\n</section>\n\n<section class=\"simposios-page\">\n<div class=\"filtros-container\">\n<div class=\"filtros-categorias\">\n<button class=\"filtro-btn active\" data-categoria=\"todos\" type=\"button\">Todos</button>\n<button class=\"filtro-btn\" data-categoria=\"conservacion\" type=\"button\">Conservación</button>\n<button class=\"filtro-btn\" data-categoria=\"ecologia\" type=\"button\">Ecología</button>\n<button class=\"filtro-btn\" data-categoria=\"primates\" type=\"button\">Primates</button>\n<button class=\"filtro-btn\" data-categoria=\"quiropteros\" type=\"button\">Quirópteros</button>\n<button class=\"filtro-btn\" data-categoria=\"estrategias\" type=\"button\">Estrategias</button>\n<button class=\"filtro-btn\" data-categoria=\"xenartros\" type=\"button\">Xenartros</button>\n<button class=\"filtro-btn\" data-categoria=\"gestion\" type=\"button\">Gestión Adaptativa</button>\n<button class=\"filtro-btn\" data-categoria=\"salud\" type=\"button\">Salud</button>\n</div>\n\n<div class=\"busqueda-wrapper\">\n<span class=\"busqueda-icon\">🔎</span>\n<input type=\"text\" class=\"busqueda-input\" placeholder=\"Buscar simposios...\" id=\"busquedaInput\">\n</div>\n</div>\n\n<div class=\"simposios-grid\" id=\"simposiosGrid\">\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"ecologia\"\ndata-titulo=\"Interacciones troficas en mamiferos: de flores a depredadores\"\ndata-organizadores=\"Kevin González Gutiérrez, John Harold Castaño Salazar\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/interacciones/images/interacciones.jpeg\" alt=\"Interacciones\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Kevin González Gutiérrez</span>\n<span class=\"simposio-organizador\">John Harold Castaño Salazar</span>\n</div>\n<h3 class=\"simposio-titulo\">Interacciones troficas en mamiferos: de flores a depredadores</h3>\n<p class=\"simposio-descripcion\">\nLas interacciones tróficas son fundamentales para comprender procesos ecológicos a nivel de individuo, especie, población y comunidad, ya que permiten analizar aspectos comportamentales, metabólicos, fenológicos, geográficos y dependientes de la escala en la transformación del paisaje.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Método</span>\n</div>\n<a href=\"simposios/interacciones/interacciones.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"estrategias, conservacion\"\ndata-titulo=\"Estrategias comunitarias en gestión del conocimiento y conservación de mamíferos\"\ndata-organizadores=\"Miguel E. Rodríguez-Posada, Dora Catalina Concha Osbahr, Bibiana Gómez-Valencia, Andrea Natalia Martínez Bulla\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/estrategias/images/estrategias.jpeg\" alt=\"Interacciones\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Miguel E. Rodríguez-Posada</span>\n<span class=\"simposio-organizador\">Dora Catalina Concha Osbahr</span>\n<span class=\"simposio-organizador\">Bibiana Gómez-Valencia</span>\n<span class=\"simposio-organizador\">Andrea Natalia Martínez Bulla</span>\n</div>\n<h3 class=\"simposio-titulo\">Estrategias comunitarias en gestión del conocimiento y conservación de mamíferos</h3>\n<p class=\"simposio-descripcion\">\nRecientemente se ha incrementado la participación de actores sociales, especialmente las comunidades locales, en las estrategias de gestión y conservación de la biodiversidad en sus territorios para garantizar su efectividad bajo su propia gobernanza.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Monitoreo Comunitario</span>\n<span class=\"tema-tag\">Gobernanza</span>\n</div>\n<a href=\"simposios/estrategias/estrategias.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"quiropteros\"\ndata-titulo=\"I Simposio de Refugios de Murciélagos en Colombia\"\ndata-organizadores=\"Liceth Margarita Suárez Payares, Tomás Villada-Cadavid, Melquisedec Gamba-Ríos, Sandra Bernal, Yesyca Andrea López Bolaños, Ana María Ávila García, Diana Carina Vallejo Cardozo\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/refugios/images/refugios.jpeg\" alt=\"Refugios\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Liceth Margarita Suárez Payares</span>\n<span class=\"simposio-organizador\">Tomás Villada-Cadavid</span>\n<span class=\"simposio-organizador\">Melquisedec Gamba-Ríos</span>\n<span class=\"simposio-organizador\">Sandra Bernal</span>\n<span class=\"simposio-organizador\">Yesyca Andrea López Bolaños</span>\n<span class=\"simposio-organizador\">Ana María Ávila García</span>\n<span class=\"simposio-organizador\">Diana Carina Vallejo Cardozo</span>\n</div>\n<h3 class=\"simposio-titulo\">I Simposio de Refugios de Murciélagos en Colombia</h3>\n<p class=\"simposio-descripcion\"> Bastaron dos décadas para percatarnos acerca de lo imperativo de proponer nuevas estrategias para el estudio de los refugios de murciélagos en Colombia.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Quirópteros</span>\n<span class=\"tema-tag\">Murciélagos</span>\n</div>\n<a href=\"simposios/refugios/refugios.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"xenartros\"\ndata-titulo=\"VI Simposio Colombiano de Perezosos, Armadillos y Hormigueros\"\ndata-organizadores=\"Carlos Aya Cuero, Maria Jose Andrade, Julio Chacón Pacheco, Catalina Perez, Nathalia Niño, Cesar Rojano\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/perezosos/images/perezosos.jpeg\" alt=\"Perezosos\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Carlos Aya Cuero</span>\n<span class=\"simposio-organizador\">Maria Jose Andrade</span>\n<span class=\"simposio-organizador\">Julio Chacón Pacheco</span>\n<span class=\"simposio-organizador\">Catalina Perez</span>\n<span class=\"simposio-organizador\">Nathalia Niño</span>\n<span class=\"simposio-organizador\">Cesar Rojano</span>\n</div>\n<h3 class=\"simposio-titulo\">VI Simposio Colombiano de Perezosos, Armadillos y Hormigueros</h3>\n<p class=\"simposio-descripcion\"> El VI Simposio Colombiano de Perezosos, Armadillos y Hormigueros da continuidad a los cinco encuentros previos que han consolidado un espacio técnico y científico dedicado al estudio y conservación de los xenartros en el país.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Xenartros</span>\n<span class=\"tema-tag\">Perezosos</span>\n</div>\n<a href=\"simposios/perezosos/perezosos.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"primates\"\ndata-titulo=\"VII Simposio Colombiano de Primatología\"\ndata-organizadores=\"Carlos Aya Cuero, Maria Jose Andrade, Julio Chacón Pacheco, Catalina Perez, Nathalia Niño, Cesar Rojano\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/primatologia/images/primatologia.jpeg\" alt=\"Primatologia\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Sebastián García Restrepo</span>\n<span class=\"simposio-organizador\">Sebastián O. Montilla</span>\n<span class=\"simposio-organizador\">María Gabriela Luna Conde</span>\n<span class=\"simposio-organizador\">Rafael Santiago Escucha Ramírez</span>\n<span class=\"simposio-organizador\">Efraín Camilo Mora Cruz</span>\n<span class=\"simposio-organizador\">Sergio González Linares</span>\n</div>\n<h3 class=\"simposio-titulo\">VII Simposio Colombiano de Primatología</h3>\n<p class=\"simposio-descripcion\"> Colombia alberga una alta riqueza de especies de primates (alrededor de 38 a 40 especies) y a lo largo de los años se ha posicionado como un referente latinoamericano en cuanto al potencial de investigación y a las capacidades de sus profesionales y grupos de investigación en Primatología.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Primates</span>\n</div>\n<a href=\"simposios/primatologia/primatologia.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"gestion, estrategias\"\ndata-titulo=\"Gestión Adaptativa y Alianzas Estratégicas: El Rol de los Zoológicos en la Mastozoología Moderna\"\ndata-organizadores=\"Dave Wehdeking, Catalina Rodríguez Álvarez, Sandra Marcela Gómez, Carlos Andrés Galvis, Leonardo Arias Bernal\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/gestion_adaptativa/images/gestion_adaptativa.jpg\" alt=\"Gestion Adaptativa\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Dave Wehdeking</span>\n<span class=\"simposio-organizador\">Catalina Rodríguez Álvarez</span>\n<span class=\"simposio-organizador\">Sandra Marcela Gómez</span>\n<span class=\"simposio-organizador\">Carlos Andrés Galvis</span>\n<span class=\"simposio-organizador\">Leonardo Arias Bernal</span>\n</div>\n<h3 class=\"simposio-titulo\">Gestión Adaptativa y Alianzas Estratégicas: El Rol de los Zoológicos en la Mastozoología Moderna</h3>\n<p class=\"simposio-descripcion\"> La conservación de los mamíferos enfrenta desafíos cada vez más complejos que requieren enfoques integrados y una colaboración efectiva entre múltiples actores.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Gestión Adaptativa</span>\n<span class=\"tema-tag\">Zoológicos</span>\n</div>\n<a href=\"simposios/gestion_adaptativa/gestion_adaptativa.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"conservacion\"\ndata-titulo=\"Comunicación, Sensibilización y Enseñanza para la Conservación de Mamíferos: Experiencias, Estrategias y Retos\"\ndata-organizadores=\"Catalina Rodriguez, César Rojano, Mónica Peñuela Salgado, Juan Camilo Rubiano Pérez, Mariana Zanotti Tavares de Oliveira, Ginna Gómez Junco, Diana Alejandra Moncada Garzón, Katherine Pérez Gómez, Angie Tinoco Sotomayor, Luisa Fernanda Blanco Uribe, Carlos Ágamez López, Oscar Ducuara, Mariana Vélez Orozco, María Camila Machado Aguilar\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/comunicacion_sensibilizacion/images/comunicacion_sensibilizacion.jpeg\" alt=\"Comunicacion, Sensibilizacion y enseñanza\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Catalina Rodriguez</span>\n<span class=\"simposio-organizador\">César Rojano</span>\n<span class=\"simposio-organizador\">Mónica Peñuela Salgado</span>\n<span class=\"simposio-organizador\">Juan Camilo Rubiano Pérez</span>\n<span class=\"simposio-organizador\">Mariana Zanotti Tavares de Oliveira</span>\n<span class=\"simposio-organizador\">Ginna Gómez Junco</span>\n<span class=\"simposio-organizador\">Diana Alejandra Moncada Garzón</span>\n<span class=\"simposio-organizador\">Katherine Pérez Gómez</span>\n<span class=\"simposio-organizador\">Angie Tinoco Sotomayor</span>\n<span class=\"simposio-organizador\">Luisa Fernanda Blanco Uribe</span>\n<span class=\"simposio-organizador\">Carlos Ágamez López</span>\n<span class=\"simposio-organizador\">Oscar Ducuara</span>\n<span class=\"simposio-organizador\">Mariana Vélez Orozco</span>\n<span class=\"simposio-organizador\">María Camila Machado Aguilar</span>\n</div>\n<h3 class=\"simposio-titulo\">Comunicación, Sensibilización y Enseñanza para la Conservación de Mamíferos: Experiencias, Estrategias y Retos</h3>\n<p class=\"simposio-descripcion\">Este simposio busca generar un espacio de encuentro e intercambio entre investigadores, docentes, estudiantes, organizaciones e iniciativas que desarrollan procesos de comunicación, sensibilización y enseñanza relacionados con la conservación de mamíferos.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Comunicación</span>\n<span class=\"tema-tag\">Enseñanza</span>\n</div>\n<a href=\"simposios/comunicacion_sensibilizacion/comunicacion_sensibilizacion.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"conservacion\"\ndata-titulo=\"Evaluaciones de amenazas: de lo global a lo local\"\ndata-organizadores=\"Maria Alejandra Hurtado Materon, Baltazar Gonzalez, José F. González-Maya\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/evaluaciones_amenazas/images/evaluaciones_amenazas.jpg\" alt=\"Evaluaciones de Amenazas\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Maria Alejandra Hurtado Materon</span>\n<span class=\"simposio-organizador\">Baltazar Gonzalez</span>\n<span class=\"simposio-organizador\">José F. González-Maya</span>\n</div>\n<h3 class=\"simposio-titulo\">Evaluaciones de amenazas: de lo global a lo local</h3>\n<p class=\"simposio-descripcion\">\nEl simposio propuesto se establece como un espacio de vanguardia para el intercambio académico y práctico sobre la evaluación de mamíferos, trascendiendo la escala nacional para entender cómo los contextos locales informan las metas globales de biodiversidad.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Método</span>\n</div>\n<a href=\"simposios/evaluaciones_amenazas/evaluaciones_amenazas.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n<div class=\"simposio-card\"\ndata-categoria=\"quiropteros\"\ndata-titulo=\"VI Simposio Colombiano de Quiropterología\"\ndata-organizadores=\"Sebastián Montoya-Bustamante, Natalya Zapata-Mesa, María A. Hurtado-Materón\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/quiropterologia/images/quiropterologia.jpg\" alt=\"quiropterologia\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Sebastián Montoya-Bustamante</span>\n<span class=\"simposio-organizador\">Natalya Zapata-Mesa</span>\n<span class=\"simposio-organizador\">María A. Hurtado-Materón</span>\n</div>\n<h3 class=\"simposio-titulo\">VI Simposio Colombiano de Quiropterología</h3>\n<p class=\"simposio-descripcion\">\nLos murciélagos constituyen uno de los grupos de mamíferos más diversos y ecológicamente relevantes del planeta, y Colombia, con su excepcional biodiversidad, alberga una de las quiropterofaunas más ricas del mundo.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">quiropteros</span>\n<span class=\"tema-tag\">Murciélagos</span>\n</div>\n<a href=\"simposios/quiropterologia/quiropterologia.html\" class=\"simposio-btn\">\nVer Simposio Completo →</a>\n</div>\n</div>\n\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"estrategias\"\ndata-titulo=\"Mamíferos en paisajes productivos de Colombia: enfoques, experiencias y retos\"\ndata-organizadores=\"Freddy Gamboa Avellaneda, Natalia Rodríguez Santa\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/mamiferos_paisajes/images/mamiferos_paisajes.png\" alt=\"Mamiferos en paisajes\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Freddy Gamboa Avellaneda</span>\n<span class=\"simposio-organizador\">Natalia Rodríguez Santa</span>\n</div>\n<h3 class=\"simposio-titulo\">Mamíferos en paisajes productivos de Colombia: enfoques, experiencias y retos</h3>\n<p class=\"simposio-descripcion\">\nEste simposio reúne experiencias, investigaciones y enfoques interdisciplinarios sobre mamíferos en paisajes productivos de Colombia, así como el potencial de territorios emergentes para la investigación.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Estrategias</span>\n</div>\n<a href=\"simposios/mamiferos_paisajes/mamiferos_paisajes.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"salud\"\ndata-titulo=\"La mastozoología en la era One health\"\ndata-organizadores=\"Hugo Mantilla-Meluk, Nicolás Rafael Reyes-Amaya\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/mastozoologia_onehealth/images/mastozoologia_onehealth.jpg\" alt=\"La mastozoología en la era One health\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Hugo Mantilla-Meluk</span>\n<span class=\"simposio-organizador\">Nicolás Rafael Reyes-Amaya</span>\n</div>\n<h3 class=\"simposio-titulo\">La mastozoología en la era One health</h3>\n<p class=\"simposio-descripcion\">\nEn consonancia con el Marco Global de Biodiversidad de Kunming-Montreal, que promueve la implementación del esquema de Una Salud.\n</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Conservación</span>\n<span class=\"tema-tag\">Salud</span>\n</div>\n<a href=\"simposios/mastozoologia_onehealth/mastozoologia_onehealth.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n<div class=\"simposio-card\"\ndata-categoria=\"ecologia\"\ndata-titulo=\"V Simposio de conectividad ecológica y V Simposio de distribución de especies\"\ndata-organizadores=\"Ángela P. Hurtado-Moreno, Diego A. Zárrate Charry, José F. González-Maya, Leonardo Lemus-Mejia, Carlos Eduardo Ortiz Yusty, María Gabriela Aduén Espinosa, Camilo Andrés Correa Ayram, Elkin Noguera, Maria Camila Machado-Aguilera\">\n<div class=\"simposio-badge\">Organizan</div>\n<div class=\"simposio-img\">\n<img src=\"simposios/conectividad_ecologica/images/conectividad_ecologica.jpg\" alt=\"Modelos y territorios: conectando ciencia para la planificación responsable\">\n</div>\n<div class=\"simposio-content\">\n<div class=\"simposio-organizadores\">\n<span class=\"simposio-organizador\">Ángela P. Hurtado-Moreno</span>\n<span class=\"simposio-organizador\">Diego A. Zárrate Charry</span>\n<span class=\"simposio-organizador\">José F. González-Maya</span>\n<span class=\"simposio-organizador\">Leonardo Lemus-Mejia</span>\n<span class=\"simposio-organizador\">Carlos Eduardo Ortiz Yusty</span>\n<span class=\"simposio-organizador\">María Gabriela Aduén Espinosa</span>\n<span class=\"simposio-organizador\">Camilo Andrés Correa Ayram</span>\n<span class=\"simposio-organizador\">Elkin Noguera</span>\n<span class=\"simposio-organizador\">Maria Camila Machado-Aguilera</span>\n</div>\n<h3 class=\"simposio-titulo\">V Simposio de conectividad ecológica y V Simposio de distribución de especies</h3>\n<p class=\"simposio-descripcion\"> Las aproximaciones de investigación direccionadas a entender cómo se distribuye una especie en el espacio y cómo se mueve a través de un paisaje permiten tener un marco conceptual y metodológico robusto para orientar la toma de decisiones en el ordenamiento territorial.</p>\n<div class=\"simposio-temas\">\n<span class=\"tema-tag\">Ecología</span>\n<span class=\"tema-tag\">Conservación</span>\n</div>\n<a href=\"simposios/conectividad_ecologica/conectividad_ecologica.html\" class=\"simposio-btn\">\nVer Simposio Completo →\n</a>\n</div>\n</div>\n\n\n\n\n</div>\n\n<div class=\"paginacion\">\n  <ul>\n    <li><a href=\"simposios.html\" class=\"page-item active\">1</a></li>\n    <li><a href=\"simposios_2.html\" class=\"page-item2\">2</a></li>\n    <li><a href=\"simposios_3.html\" class=\"page-item3\">3</a></li>\n    <li><a href=\"simposios_2.html\" class=\"page-item4\">→</a></li>\n  </ul>\n</div>\n</section>\n\n\n\n<section class=\"newsletter-section\">\n<div class=\"newsletter-container\">\n<h2>📬 Recibe nuestras noticias</h2>\n<p>Suscríbete para recibir las últimas actualizaciones del congreso directamente en tu correo</p>\n<div class=\"newsletter-form\">\n<input type=\"email\" class=\"newsletter-input\" placeholder=\"Tu correo electrónico\">\n<button class=\"newsletter-btn\" type=\"button\">Suscribirme</button>\n</div>\n</div>\n</section>\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":false,"output":true,"warning":false,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"message":false,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makei